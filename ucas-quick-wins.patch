+  animation: easter-egg-spin 1.4s var(--ease-out);
+}
+
+@keyframes easter-egg-spin {
+  0% {
+    transform: rotate(0deg) scale(1);
+  }
+  45% {
+    transform: rotate(360deg) scale(1.14);
+  }
+  100% {
+    transform: rotate(360deg) scale(1);
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .role-rotator span {
+    position: static;
+    display: block;
+    animation: none;
+    opacity: 1;
+  }
+
+  .role-rotator span:nth-child(n + 2) {
+    display: none;
+  }
+
+  .scroll-progress-bar {
+    transition: none;
+  }
+
+  body.easter-egg-active .mini-brand img,
+  body.easter-egg-active .profile-avatar img {
+    animation: none;
+  }
+}
